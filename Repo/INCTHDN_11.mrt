              <Page isRef="83" />
              <Parent isRef="84" />
              <Text>Bơm mỡ vào tất cả các vú mỡ.</Text>
              <TextBrush>Black</TextBrush>
              <VertAlignment>Center</VertAlignment>
            </Text83>
            <Text84 Ref="100" type="Text" isKey="true">
