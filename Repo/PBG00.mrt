              <Page isRef="4" />
              <Parent isRef="56" />
              <Text>Giao xe theo hợp đồng</Text>
              <TextBrush>Black</TextBrush>
              <VertAlignment>Center</VertAlignment>
            </Text41>
            <Text42 Ref="62" type="Text" isKey="true">
