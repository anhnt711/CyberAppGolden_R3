        <Text60 Ref="6" type="Text" isKey="true">
          <Brush>Transparent</Brush>
          <CanGrow>True</CanGrow>
          <ClientRectangle>2,263,182,12</ClientRectangle>
          <Conditions isList="true" count="0" />
