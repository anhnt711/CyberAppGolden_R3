              <Page isRef="125" />
              <Parent isRef="126" />
              <Text>ĐIỀU 3. HIỆU LỰC PHỤ LỤC HỢP ĐỒNG</Text>
              <TextBrush>Black</TextBrush>
              <Type>Expression</Type>
              <VertAlignment>Center</VertAlignment>
