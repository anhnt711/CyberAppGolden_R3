              <Margins>0,0,0,0</Margins>
              <Name>Text44</Name>
              <Page isRef="5" />
              <Parent isRef="7" />
              <Text>Cử người có trách nhiệm thường xuyên theo dõi , hợp tác với bên B trong quá trình sửa chữa.</Text>
              <TextBrush>Black</TextBrush>
              <TextOptions>,,,,WordWrap=True,A=0</TextOptions>
              <Type>Expression</Type>
              <VertAlignment>Center</VertAlignment>
            </Text44>
