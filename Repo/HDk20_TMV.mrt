            <Text1 Ref="50" type="Text" isKey="true">
              <Brush>Transparent</Brush>
              <CanGrow>True</CanGrow>
              <ClientRectangle>0.2,10.1,7.3,0.6</ClientRectangle>
              <Conditions isList="true" count="0" />
