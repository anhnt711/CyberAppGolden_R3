              <Page isRef="14" />
              <Parent isRef="22" />
              <Text>Tài khoản</Text>
              <TextBrush>Black</TextBrush>
              <Type>Expression</Type>
              <VertAlignment>Center</VertAlignment>
            </Text84>
            <Text85 Ref="54" type="Text" isKey="true">
              <Brush>Transparent</Brush>
              <CanBreak>True</CanBreak>
              <CanGrow>True</CanGrow>
              <ClientRectangle>2,57,174,11</ClientRectangle>
              <Conditions isList="true" count="0" />
              <Font>Times New Roman,12</Font>
              <Guid>559cc0ec7c3e4adda4d34ba1ea3bcfed</Guid>
              <Margins>0,0,0,0</Margins>
              <Name>Text85</Name>
              <Page isRef="14" />
              <Parent isRef="22" />
              <Text>	Người liên hệ được Bên A ủy quyền để thay mặt Bên A thực hiện các nghĩa vụ quy định trong hợp đồng này.</Text>
              <TextBrush>Black</TextBrush>
              <TextOptions>,,,,WordWrap=True,A=0</TextOptions>
              <Type>Expression</Type>
              <VertAlignment>Center</VertAlignment>
            </Text85>
