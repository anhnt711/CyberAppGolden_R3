              <Name>Text6</Name>
              <Page isRef="5" />
              <Parent isRef="6" />
              <Text>1. Hai bên hủy hợp đồng trên vô điều kiện.</Text>
              <TextBrush>Black</TextBrush>
              <Type>Expression</Type>
              <VertAlignment>Center</VertAlignment>
            </Text6>
