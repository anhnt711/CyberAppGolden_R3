            <Text6 Ref="33" type="Text" isKey="true">
              <Border>None;Black;1;Dash;False;4;Black</Border>
              <Brush>Transparent</Brush>
              <ClientRectangle>0.1,5.5,7.2,0.2</ClientRectangle>
