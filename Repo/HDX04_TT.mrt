              <Name>Text19</Name>
              <Page isRef="5" />
              <Parent isRef="23" />
              <Text>5. 01 Châm thuốc lá
6. 01 Bộ chìa khóa
7. 01 Sổ bảo hành
8. 01 Sách hướng dẫn sử dụng xe bằng Tiếng Việt

</Text>
              <TextBrush>Black</TextBrush>
              <Type>Expression</Type>
            </Text19>
