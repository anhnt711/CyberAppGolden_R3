              <Name>Text18</Name>
              <Page isRef="5" />
              <Parent isRef="23" />
              <Text>1. 01 Kích
2. 01 Tay quay kích
3. 01 Dụng cụ mở bánh xe
4. 01 Bánh xe dự phòng
</Text>
