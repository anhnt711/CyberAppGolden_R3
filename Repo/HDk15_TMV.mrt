              <Guid>9e99ff8b2fd84896b0998ed24b904919</Guid>
              <Margins>0,0,0,0</Margins>
              <Name>Text37</Name>
              <Page isRef="5" />
              <Parent isRef="7" />
              <Text>    Đã kiểm tra xác nhận toàn bộ nội dung công việc được ghi trong báo giá sửa chữa. </Text>
              <TextBrush>Black</TextBrush>
              <TextOptions>,,,,WordWrap=True,A=0</TextOptions>
              <Type>Expression</Type>
              <VertAlignment>Center</VertAlignment>
            </Text37>
