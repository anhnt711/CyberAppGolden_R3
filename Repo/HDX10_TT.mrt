          <ClientRectangle>0,24.16,181,16</ClientRectangle>
          <Components isList="true" count="1">
            <Text128 Ref="195" type="Text" isKey="true">
              <Brush>Transparent</Brush>
              <CanBreak>True</CanBreak>
