</Text>
              <TextBrush>Black</TextBrush>
              <Type>Expression</Type>
            </Text99>
            <Text96 Ref="244" type="Text" isKey="true">
              <Brush>Transparent</Brush>
              <CanGrow>True</CanGrow>
              <CanShrink>True</CanShrink>
              <ClientRectangle>6,50,174,6</ClientRectangle>
              <Conditions isList="true" count="0" />
              <Font>Times New Roman,12</Font>
              <Guid>2b456291195e41b580d2fe4d08458961</Guid>
              <HorAlignment>Width</HorAlignment>
              <Margins>0,0,0,0</Margins>
              <Name>Text96</Name>
              <Page isRef="227" />
              <Parent isRef="235" />
              <Text>Địa điểm bảo hành:tại cơ sở bảo hành của Bên Bán hoặc Đại lý/Trạm dịch vụ ủy quyền của TMV.
</Text>
              <TextBrush>Black</TextBrush>
              <TextOptions>,,,,WordWrap=True,A=0</TextOptions>
              <Type>Expression</Type>
            </Text96>
          </Components>
          <Conditions isList="true" count="0" />
