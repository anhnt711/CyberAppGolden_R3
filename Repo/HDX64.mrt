      <Brush>Transparent</Brush>
      <Components isList="true" count="58">
        <Text1 Ref="6" type="Text" isKey="true">
          <Brush>Transparent</Brush>
          <ClientRectangle>0,38,162,8</ClientRectangle>
          <Conditions isList="true" count="0" />
