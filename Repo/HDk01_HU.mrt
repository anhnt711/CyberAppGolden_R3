              <Guid>c3cad263f3334c78b19e27b5216f63e3</Guid>
              <Margins>0,0,0,0</Margins>
              <Name>Text8</Name>
              <Page isRef="388" />
              <Parent isRef="425" />
              <Text>Quý khách hẹn trước cho lần bảo dưỡng sau:</Text>
              <TextBrush>Black</TextBrush>
              <Type>Expression</Type>
              <VertAlignment>Center</VertAlignment>
            </Text8>
            <Text10 Ref="428" type="Text" isKey="true">
              <Brush>Transparent</Brush>
              <ClientRectangle>0,0.5,0.39,0.2</ClientRectangle>
              <Conditions isList="true" count="0" />
