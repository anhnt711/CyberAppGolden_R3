              <Name>Text7</Name>
              <Page isRef="388" />
              <Parent isRef="425" />
              <Text>Tất cả hạng mục sửa chữa đều được bảo hành theo chính sách bảo hành của Công ty</Text>
              <TextBrush>Black</TextBrush>
