              <Page isRef="193" />
              <Parent isRef="213" />
              <Text>1.</Text>
              <TextBrush>Black</TextBrush>
              <Type>Expression</Type>
            </Text104>
            <Text89 Ref="217" type="Text" isKey="true">
              <Brush>Transparent</Brush>
              <ClientRectangle>2,12.14,4,10</ClientRectangle>
              <Conditions isList="true" count="0" />
