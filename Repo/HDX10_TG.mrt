        <ReportSummaryBand3 Ref="233" type="ReportSummaryBand" isKey="true">
          <Brush>Transparent</Brush>
          <CanBreak>True</CanBreak>
          <CanShrink>True</CanShrink>
          <ClientRectangle>0,4,181,10</ClientRectangle>
          <Components isList="true" count="2">
            <Text106 Ref="234" type="Text" isKey="true">
              <Brush>Transparent</Brush>
              <CanBreak>True</CanBreak>
              <CanGrow>True</CanGrow>
              <ClientRectangle>6,0,174,10</ClientRectangle>
              <Conditions isList="true" count="0" />
              <Font>Times New Roman,12</Font>
              <HorAlignment>Width</HorAlignment>
              <Margins>0,0,0,0</Margins>
              <Name>Text106</Name>
              <Page isRef="224" />
              <Parent isRef="233" />
              <Text>Quyền sở hữu và rủi ro đối với hàng hóa được coi là đã chuyển từ Bên Bán sang Bên Mua kể từ thời điểm xe được giao cho Bên Mua hoặc người được Bên Mua ủy quyền.
</Text>
              <TextBrush>Black</TextBrush>
              <TextOptions>,,,,WordWrap=True,A=0</TextOptions>
              <Type>Expression</Type>
            </Text106>
            <Text109 Ref="235" type="Text" isKey="true">
              <Brush>Transparent</Brush>
              <ClientRectangle>2,0,4,10</ClientRectangle>
              <Conditions isList="true" count="0" />
              <Font>Times New Roman,12,Bold</Font>
              <Guid>bfc5b78a2d5846f69ea68865b729dade</Guid>
              <Margins>0,0,0,0</Margins>
              <Name>Text109</Name>
              <Page isRef="224" />
              <Parent isRef="233" />
              <Text>5.</Text>
              <TextBrush>Black</TextBrush>
              <Type>Expression</Type>
            </Text109>
          </Components>
          <Conditions isList="true" count="0" />
          <Guid>62921be2c0c74a8b89ce71ac10889af3</Guid>
