              <Name>Text57</Name>
              <Page isRef="273" />
              <Parent isRef="287" />
              <Text>ĐIỀU 7: ĐIỀU KHOẢN CHUNG.</Text>
              <TextBrush>Black</TextBrush>
              <Type>Expression</Type>
              <VertAlignment>Center</VertAlignment>
            </Text57>
            <Text58 Ref="289" type="Text" isKey="true">
              <Brush>Transparent</Brush>
              <CanBreak>True</CanBreak>
              <CanGrow>True</CanGrow>
              <ClientRectangle>6,6,174,5</ClientRectangle>
              <Conditions isList="true" count="0" />
              <Font>Times New Roman,12</Font>
              <Guid>b57bb3ddc6174606b4ca88f6a7375c48</Guid>
              <HorAlignment>Width</HorAlignment>
              <Margins>0,0,0,0</Margins>
              <Name>Text58</Name>
              <Page isRef="273" />
              <Parent isRef="287" />
              <Text>Việc thay đổi tên của Bên Mua trên hợp đồng và/hoặc trên hóa đơn sẽ không được chấp nhận. 
</Text>
              <TextBrush>Black</TextBrush>
              <TextOptions>,,,,WordWrap=True,A=0</TextOptions>
              <TextQuality>Wysiwyg</TextQuality>
              <Type>Expression</Type>
            </Text58>
            <Text59 Ref="290" type="Text" isKey="true">
              <Brush>Transparent</Brush>
              <ClientRectangle>0,61.5,90,8</ClientRectangle>
              <Conditions isList="true" count="0" />
              <Font>Times New Roman,12,Bold</Font>
              <Guid>124b0fd4fa8f4a96be700cbf23796f93</Guid>
              <HorAlignment>Center</HorAlignment>
              <Margins>0,0,0,0</Margins>
              <Name>Text59</Name>
              <Page isRef="273" />
              <Parent isRef="287" />
              <Text>ĐẠI DIỆN BÊN MUA</Text>
              <TextBrush>Black</TextBrush>
              <Type>Expression</Type>
              <VertAlignment>Center</VertAlignment>
            </Text59>
            <Text60 Ref="291" type="Text" isKey="true">
              <Brush>Transparent</Brush>
              <ClientRectangle>90,61.5,90,8</ClientRectangle>
              <Conditions isList="true" count="0" />
              <Font>Times New Roman,12,Bold</Font>
