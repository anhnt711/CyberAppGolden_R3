            </Text102>
            <Text103 Ref="215" type="Text" isKey="true">
              <Brush>Transparent</Brush>
              <CanBreak>True</CanBreak>
              <CanGrow>True</CanGrow>
              <ClientRectangle>6,6.14,174,6</ClientRectangle>
              <Conditions isList="true" count="0" />
              <Font>Times New Roman,12</Font>
              <HorAlignment>Width</HorAlignment>
              <Margins>0,0,0,0</Margins>
              <Name>Text103</Name>
              <Page isRef="193" />
              <Parent isRef="213" />
              <Text>Thời gian giao hàng dự kiến được thực hiện vào ngày: {Format("{0:dd/MM/yyyy}", Table0.Ngay_GX)} tùy theo lịch giao hàng của TMV.
</Text>
              <TextBrush>Black</TextBrush>
              <TextOptions>,,,,WordWrap=True,A=0</TextOptions>
              <Type>Expression</Type>
            </Text103>
            <Text104 Ref="216" type="Text" isKey="true">
              <Brush>Transparent</Brush>
              <ClientRectangle>2,6.14,4,6</ClientRectangle>
              <Conditions isList="true" count="0" />
