              <Margins>0,0,0,0</Margins>
              <Name>Text10</Name>
              <Page isRef="5" />
              <Parent isRef="6" />
              <Text>Kiểm tra vặn chặt hệ thống nhíp, các đăng.</Text>
              <TextBrush>Black</TextBrush>
              <TextOptions>,,,,WordWrap=True,A=0</TextOptions>
              <VertAlignment>Center</VertAlignment>
            </Text10>
            <Text11 Ref="22" type="Text" isKey="true">
              <Border>All;Black;1;Solid;False;4;Black</Border>
              <Brush>Transparent</Brush>
              <ClientRectangle>8,76,132,8</ClientRectangle>
              <Conditions isList="true" count="0" />
              <Font>Times New Roman,12</Font>
              <Margins>0,0,0,0</Margins>
              <Name>Text11</Name>
              <Page isRef="5" />
              <Parent isRef="6" />
              <Text>Kiểm tra xiết chặt hộp số.</Text>
              <TextBrush>Black</TextBrush>
              <TextOptions>,,,,WordWrap=True,A=0</TextOptions>
              <VertAlignment>Center</VertAlignment>
            </Text11>
            <Text14 Ref="23" type="Text" isKey="true">
              <Border>All;Black;1;Solid;False;4;Black</Border>
              <Brush>Transparent</Brush>
              <ClientRectangle>8,84,132,8</ClientRectangle>
              <Conditions isList="true" count="0" />
              <Font>Times New Roman,12</Font>
              <Margins>0,0,0,0</Margins>
              <Name>Text14</Name>
              <Page isRef="5" />
              <Parent isRef="6" />
              <Text>Kiểm tra siết chặt hệ thống cột chống, dây vịn, bản lề cửa, chân ghế.</Text>
              <TextBrush>Black</TextBrush>
              <TextOptions>,,,,WordWrap=True,A=0</TextOptions>
              <VertAlignment>Center</VertAlignment>
            </Text14>
            <Text17 Ref="24" type="Text" isKey="true">
              <Border>All;Black;1;Solid;False;4;Black</Border>
              <Brush>Transparent</Brush>
              <ClientRectangle>8,92,132,12</ClientRectangle>
              <Conditions isList="true" count="0" />
              <Font>Times New Roman,12</Font>
              <Margins>0,0,0,0</Margins>
              <Name>Text17</Name>
              <Page isRef="5" />
              <Parent isRef="6" />
              <Text>Kiểm tra hệ thống côn, điều chỉnh theo các thông số chuẩn của Nhà sản xuất. (*)</Text>
              <TextBrush>Black</TextBrush>
              <TextOptions>,,,,WordWrap=True,A=0</TextOptions>
              <VertAlignment>Center</VertAlignment>
            </Text17>
            <Text18 Ref="25" type="Text" isKey="true">
              <Border>All;Black;1;Solid;False;4;Black</Border>
              <Brush>Transparent</Brush>
              <ClientRectangle>8,104,132,8</ClientRectangle>
              <Conditions isList="true" count="0" />
              <Font>Times New Roman,12</Font>
              <Margins>0,0,0,0</Margins>
              <Name>Text18</Name>
              <Page isRef="5" />
              <Parent isRef="6" />
              <Text>Kiểm tra, điều chỉnh độ nhạy chân ga.</Text>
              <TextBrush>Black</TextBrush>
              <TextOptions>,,,,WordWrap=True,A=0</TextOptions>
              <VertAlignment>Center</VertAlignment>
            </Text18>
            <Text19 Ref="26" type="Text" isKey="true">
              <Border>All;Black;1;Solid;False;4;Black</Border>
              <Brush>Transparent</Brush>
              <ClientRectangle>8,112,132,12</ClientRectangle>
              <Conditions isList="true" count="0" />
              <Font>Times New Roman,12</Font>
              <Margins>0,0,0,0</Margins>
              <Name>Text19</Name>
              <Page isRef="5" />
              <Parent isRef="6" />
              <Text>Kiểm tra mức dầu trong các hộp chứa: Động cơ, Thiếu bổ sung, thay thế khi đến định ngạch. (*)</Text>
              <TextBrush>Black</TextBrush>
              <TextOptions>,,,,WordWrap=True,A=0</TextOptions>
              <VertAlignment>Center</VertAlignment>
            </Text19>
            <Text20 Ref="27" type="Text" isKey="true">
              <Border>All;Black;1;Solid;False;4;Black</Border>
              <Brush>Transparent</Brush>
              <ClientRectangle>8,124,132,12</ClientRectangle>
              <Conditions isList="true" count="0" />
              <Font>Times New Roman,12</Font>
              <Margins>0,0,0,0</Margins>
              <Name>Text20</Name>
              <Page isRef="5" />
              <Parent isRef="6" />
              <Text>Kiểm tra mức dầu trong các hộp chứa : hộp số, cầu sau, dầu phanh, dầu côn, dầu trợ lực lái. Thiếu bổ sung, thay thế khi đến định ngạch.</Text>
              <TextBrush>Black</TextBrush>
              <TextOptions>,,,,WordWrap=True,A=0</TextOptions>
              <VertAlignment>Center</VertAlignment>
            </Text20>
            <Text21 Ref="28" type="Text" isKey="true">
              <Border>All;Black;1;Solid;False;4;Black</Border>
              <Brush>Transparent</Brush>
              <ClientRectangle>8,136,132,8</ClientRectangle>
              <Conditions isList="true" count="0" />
              <Font>Times New Roman,12</Font>
              <Margins>0,0,0,0</Margins>
              <Name>Text21</Name>
              <Page isRef="5" />
              <Parent isRef="6" />
              <Text>Xả bẩn trong bình chứa hơi. (*)</Text>
              <TextBrush>Black</TextBrush>
              <TextOptions>,,,,WordWrap=True,A=0</TextOptions>
              <VertAlignment>Center</VertAlignment>
            </Text21>
            <Text22 Ref="29" type="Text" isKey="true">
              <Border>All;Black;1;Solid;False;4;Black</Border>
              <Brush>Transparent</Brush>
              <ClientRectangle>8,144,132,12</ClientRectangle>
              <Conditions isList="true" count="0" />
              <Font>Times New Roman,12</Font>
              <Margins>0,0,0,0</Margins>
              <Name>Text22</Name>
              <Page isRef="5" />
              <Parent isRef="6" />
              <Text>Kiểm tra điều chỉnh tác dụng của phanh tay, phanh chân theo các thông số kỹ thuật chuẩn của Nhà SX.</Text>
              <TextBrush>Black</TextBrush>
              <TextOptions>,,,,WordWrap=True,A=0</TextOptions>
              <VertAlignment>Center</VertAlignment>
            </Text22>
            <Text23 Ref="30" type="Text" isKey="true">
              <Border>All;Black;1;Solid;False;4;Black</Border>
              <Brush>Transparent</Brush>
              <ClientRectangle>8,156,132,12</ClientRectangle>
              <Conditions isList="true" count="0" />
              <Font>Times New Roman,12</Font>
              <Margins>0,0,0,0</Margins>
              <Name>Text23</Name>
              <Page isRef="5" />
              <Parent isRef="6" />
              <Text>Kiểm tra mức điện tích trong bình điện, bổ sung nước cất, thông lỗ thông hơi, kiểm tra toàn bộ hệ thống  đèn, còi, gạt mưa. (*)</Text>
              <TextBrush>Black</TextBrush>
              <TextOptions>,,,,WordWrap=True,A=0</TextOptions>
              <VertAlignment>Center</VertAlignment>
            </Text23>
            <Text24 Ref="31" type="Text" isKey="true">
              <Border>All;Black;1;Solid;False;4;Black</Border>
              <Brush>Transparent</Brush>
              <ClientRectangle>8,168,132,12</ClientRectangle>
              <Conditions isList="true" count="0" />
              <Font>Times New Roman,12</Font>
              <Margins>0,0,0,0</Margins>
              <Name>Text24</Name>
              <Page isRef="5" />
              <Parent isRef="6" />
              <Text>Kiểm tra tình trạng hoạt động của hệ thống máy phát điện, máy đề. Sửa chữa khi cần.</Text>
              <TextBrush>Black</TextBrush>
              <TextOptions>,,,,WordWrap=True,A=0</TextOptions>
              <VertAlignment>Center</VertAlignment>
            </Text24>
            <Text25 Ref="32" type="Text" isKey="true">
              <Border>All;Black;1;Solid;False;4;Black</Border>
              <Brush>Transparent</Brush>
              <ClientRectangle>8,180,132,12</ClientRectangle>
              <Conditions isList="true" count="0" />
              <Font>Times New Roman,12</Font>
              <Margins>0,0,0,0</Margins>
              <Name>Text25</Name>
              <Page isRef="5" />
              <Parent isRef="6" />
              <Text>Kiểm tra các lốp, độ đảo, méo, không đồng đều và áp suất hơi lốp, bơm lốp. (*)</Text>
              <TextBrush>Black</TextBrush>
              <TextOptions>,,,,WordWrap=True,A=0</TextOptions>
              <VertAlignment>Center</VertAlignment>
            </Text25>
            <Text26 Ref="33" type="Text" isKey="true">
              <Border>All;Black;1;Solid;False;4;Black</Border>
              <Brush>Transparent</Brush>
              <ClientRectangle>8,192,132,12</ClientRectangle>
              <Conditions isList="true" count="0" />
              <Font>Times New Roman,12</Font>
              <Margins>0,0,0,0</Margins>
              <Name>Text26</Name>
              <Page isRef="5" />
              <Parent isRef="6" />
              <Text>Kiểm tra tình trạng của các cửa và sự làm việc của hệ thống đóng mở cửa bằng điện, hoặc bằng hơi.</Text>
              <TextBrush>Black</TextBrush>
              <TextOptions>,,,,WordWrap=True,A=0</TextOptions>
              <VertAlignment>Center</VertAlignment>
            </Text26>
            <Text27 Ref="34" type="Text" isKey="true">
              <Border>All;Black;1;Solid;False;4;Black</Border>
              <Brush>Transparent</Brush>
              <ClientRectangle>8,204,132,16</ClientRectangle>
              <Conditions isList="true" count="0" />
              <Font>Times New Roman,12</Font>
              <Margins>0,0,0,0</Margins>
              <Name>Text27</Name>
              <Page isRef="5" />
              <Parent isRef="6" />
              <Text>Kiểm tra sự hoạt động bình thường của hệ thống: công tắc nguồn, công tắc điều chỉnh nhiệt độ điều hòa, công tắc quạt gió, độ lạnh, gió ra, đèn báo trên bảng táp lô.</Text>
              <TextBrush>Black</TextBrush>
              <TextOptions>,,,,WordWrap=True,A=0</TextOptions>
              <VertAlignment>Center</VertAlignment>
            </Text27>
            <Text28 Ref="35" type="Text" isKey="true">
              <Border>All;Black;1;Solid;False;4;Black</Border>
              <Brush>Transparent</Brush>
              <ClientRectangle>8,220,132,12</ClientRectangle>
              <Conditions isList="true" count="0" />
              <Font>Times New Roman,12</Font>
              <Margins>0,0,0,0</Margins>
              <Name>Text28</Name>
              <Page isRef="5" />
              <Parent isRef="6" />
              <Text>Kiểm tra, vệ sinh các lưới lọc khí, dàn nóng, dàn lạnh, hoạt động bình thường của các quạt dàn nóng, dàn lạnh.</Text>
              <TextBrush>Black</TextBrush>
              <TextOptions>,,,,WordWrap=True,A=0</TextOptions>
              <VertAlignment>Center</VertAlignment>
            </Text28>
            <Text30 Ref="36" type="Text" isKey="true">
              <Border>All;Black;1;Solid;False;4;Black</Border>
              <Brush>Transparent</Brush>
              <ClientRectangle>8,248,132,10</ClientRectangle>
              <Conditions isList="true" count="0" />
              <Font>Times New Roman,12</Font>
              <Margins>0,0,0,0</Margins>
              <Name>Text30</Name>
              <Page isRef="5" />
              <Parent isRef="6" />
              <Text>Kiểm tra sự dò rỉ ga ở các mối nối, sự thiếu hụt ga, dầu bôi trơn máy nén, làm vệ sinh mặt ngoài các đường ống.</Text>
              <TextBrush>Black</TextBrush>
              <TextOptions>,,,,WordWrap=True,A=0</TextOptions>
              <VertAlignment>Center</VertAlignment>
            </Text30>
            <Text31 Ref="37" type="Text" isKey="true">
              <Border>All;Black;1;Solid;False;4;Black</Border>
              <Brush>Transparent</Brush>
              <ClientRectangle>8,258,132,6</ClientRectangle>
              <Conditions isList="true" count="0" />
              <Font>Times New Roman,12</Font>
              <Margins>0,0,0,0</Margins>
              <Name>Text31</Name>
              <Page isRef="5" />
              <Parent isRef="6" />
              <Text>Kiểm tra tình trạng hoạt động của hệ thống bơm mỡ tự động</Text>
              <TextBrush>Black</TextBrush>
              <TextOptions>,,,,WordWrap=True,A=0</TextOptions>
              <VertAlignment>Center</VertAlignment>
            </Text31>
            <Text32 Ref="38" type="Text" isKey="true">
              <Border>All;Black;1;Solid;False;4;Black</Border>
              <Brush>Transparent</Brush>
              <ClientRectangle>8,264,132,6</ClientRectangle>
              <Conditions isList="true" count="0" />
              <Font>Times New Roman,12</Font>
              <Margins>0,0,0,0</Margins>
              <Name>Text32</Name>
              <Page isRef="5" />
              <Parent isRef="6" />
              <Text>Kiểm tra mức dung dịch xử lý khí thải, bổ sung nếu thiếu.</Text>
              <TextBrush>Black</TextBrush>
              <TextOptions>,,,,WordWrap=True,A=0</TextOptions>
              <VertAlignment>Center</VertAlignment>
            </Text32>
            <Text33 Ref="39" type="Text" isKey="true">
              <Border>All;Black;1;Solid;False;4;Black</Border>
              <Brush>Transparent</Brush>
              <ClientRectangle>8,270,132,6</ClientRectangle>
              <Conditions isList="true" count="0" />
              <Font>Times New Roman,12</Font>
              <Margins>0,0,0,0</Margins>
              <Name>Text33</Name>
              <Page isRef="5" />
              <Parent isRef="6" />
              <Text>Bơm mỡ vào các vú mỡ.(*)</Text>
              <TextBrush>Black</TextBrush>
              <TextOptions>,,,,WordWrap=True,A=0</TextOptions>
              <VertAlignment>Center</VertAlignment>
            </Text33>
            <Text34 Ref="40" type="Text" isKey="true">
              <Brush>Transparent</Brush>
              <ClientRectangle>0,276,180,6</ClientRectangle>
              <Conditions isList="true" count="0" />
              <Font>Times New Roman,12,Bold</Font>
              <Margins>0,0,0,0</Margins>
              <Name>Text34</Name>
              <Page isRef="5" />
              <Parent isRef="6" />
              <Text>Ghi chú: bắt buộc kiểm soát 100% đối với nội dung có dấu (*)</Text>
              <TextBrush>Black</TextBrush>
              <TextOptions>,,,,WordWrap=True,A=0</TextOptions>
              <VertAlignment>Center</VertAlignment>
            </Text34>
