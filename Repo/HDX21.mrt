            <Text65 Ref="61" type="Text" isKey="true">
              <Brush>Transparent</Brush>
              <CanGrow>True</CanGrow>
              <ClientRectangle>2,62,176,10</ClientRectangle>
              <Conditions isList="true" count="0" />
              <Font>Times New Roman,12</Font>
              <Guid>8757cc3af3fc4b9bbf6be72d21c2b942</Guid>
              <HorAlignment>Width</HorAlignment>
              <Margins>0,0,0,0</Margins>
              <Name>Text65</Name>
              <Page isRef="5" />
              <Parent isRef="45" />
              <Text>	Trên cơ sở thỏa thuận, hai bên thống nhất ký kết hợp đồng mua bán xe ô tô Toyota với các điều khoản sau đây:</Text>
              <TextBrush>Black</TextBrush>
              <TextOptions>,,,,WordWrap=True,A=0</TextOptions>
              <Type>Expression</Type>
              <VertAlignment>Center</VertAlignment>
            </Text65>
          </Components>
          <Conditions isList="true" count="0" />
