              <Margins>0,0,0,0</Margins>
              <Name>Text155</Name>
              <Page isRef="232" />
              <Parent isRef="240" />
              <Text>2.



</Text>
              <TextBrush>Black</TextBrush>
              <Type>Expression</Type>
            </Text155>
            <Text156 Ref="247" type="Text" isKey="true">
              <Brush>Transparent</Brush>
              <ClientRectangle>6,32,4,20</ClientRectangle>
              <Conditions isList="true" count="0" />
