        <ReportSummaryBand1 Ref="272" type="ReportSummaryBand" isKey="true">
          <Brush>Transparent</Brush>
          <ClientRectangle>0,202,194.76,16</ClientRectangle>
          <Components isList="true" count="3">
            <Text1 Ref="273" type="Text" isKey="true">
              <Brush>Transparent</Brush>
              <ClientRectangle>8,0,182,6</ClientRectangle>
              <Conditions isList="true" count="0" />
              <Font>Times New Roman,11</Font>
              <Guid>35f5d500b46842b2bdf0819023f7525d</Guid>
              <Margins>0,0,0,0</Margins>
              <Name>Text1</Name>
              <Page isRef="6" />
              <Parent isRef="272" />
              <Text>* Báo giá này có giá trị trong vòng 7 ngày. Mọi phát sinh trong quá trình sửa chữa chúng tôi sẽ thông báo sau.</Text>
              <TextBrush>Black</TextBrush>
              <Type>Expression</Type>
              <VertAlignment>Center</VertAlignment>
            </Text1>
            <Text13 Ref="274" type="Text" isKey="true">
              <Brush>Transparent</Brush>
              <ClientRectangle>8,5,182,6</ClientRectangle>
              <Conditions isList="true" count="0" />
              <Font>Times New Roman,11</Font>
              <Guid>46a60bea7caa40538538566b1e74988c</Guid>
              <Margins>0,0,0,0</Margins>
              <Name>Text13</Name>
              <Page isRef="6" />
              <Parent isRef="272" />
              <Text>* Trước khi xe đến sửa chữa, bảo dưỡng xin hãy liên hệ với cố vấn dịch vụ.</Text>
              <TextBrush>Black</TextBrush>
              <Type>Expression</Type>
              <VertAlignment>Center</VertAlignment>
            </Text13>
            <Text19 Ref="275" type="Text" isKey="true">
              <Brush>Transparent</Brush>
              <ClientRectangle>8,10,182,6</ClientRectangle>
              <Conditions isList="true" count="0" />
              <Font>Times New Roman,11</Font>
              <Guid>08f74cd45c49407192f610ec272c386e</Guid>
              <Margins>0,0,0,0</Margins>
              <Name>Text19</Name>
              <Page isRef="6" />
              <Parent isRef="272" />
              <Text>* Thời gian bảo hành phụ tùng: 06 tháng hoặc 12.000 km tùy thuộc vào điều kiện nào đến trước.</Text>
              <TextBrush>Black</TextBrush>
              <Type>Expression</Type>
              <VertAlignment>Center</VertAlignment>
            </Text19>
          </Components>
          <Conditions isList="true" count="0" />
          <Name>ReportSummaryBand1</Name>
          <Page isRef="6" />
          <Parent isRef="6" />
        </ReportSummaryBand1>
